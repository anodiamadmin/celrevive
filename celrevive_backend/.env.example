# Placeholder only; replace with the deployed PostgreSQL connection string.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/celrevive
SKIN_IMAGE_STORAGE_ROOT=./data/skin_images
VISUAL_AI_MODEL=gemini-2.5-pro
GEMINI_API_KEY=replace_with_your_gemini_api_key

# --- File constraints ---
ALLOWED_CONTENT_TYPES_RAW=image/jpeg,image/png,image/webp
MAX_FILE_SIZE_MB=10

# --- Resolution ---
MIN_WIDTH_PX=480
MIN_HEIGHT_PX=480

# --- Sharpness (Laplacian variance) ---
# Below this, image is considered blurry. Tune against real Sprint-1 test images.
BLUR_THRESHOLD=100.0

# --- Brightness (mean pixel intensity, 0-255) ---
LOW_LIGHT_THRESHOLD=40.0
OVEREXPOSED_THRESHOLD=235.0

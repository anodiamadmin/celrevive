# --- File constraints ---
ALLOWED_CONTENT_TYPES_RAW=image/jpeg,image/png,image/webp
MAX_FILE_SIZE_MB=10

# --- Resolution ---
MIN_WIDTH_PX=480
MIN_HEIGHT_PX=480

# --- Sharpness (Laplacian variance) ---
# Below this, image is considered blurry. Tune against real Sprint-1 test images.
BLUR_THRESHOLD=100.0

# --- Brightness (mean pixel intensity, 0-255) ---
LOW_LIGHT_THRESHOLD=40.0
OVEREXPOSED_THRESHOLD=235.0

# --- Persistence ---
# PostgreSQL connection string used by the image workflow.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/celrevive
# Development storage adapter. Production should point this adapter at object storage.
IMAGE_STORAGE_DIR=./data/skin-images
CORS_ORIGINS_RAW=http://localhost:5173

# --- Visual AI ---
# Endpoint must return the strict image_detection.json-shaped response.
VISUAL_AI_URL=http://localhost:9000/api/v1/visual-ai
VISUAL_AI_TIMEOUT_SECONDS=30
